{
  "name": "appoficina",
  "version": "0.2.0",
  "private": true,
  "description": "AppOficina para Windows con servidor local, autenticación y mapas",
  "scripts": {
    "start": "node server.js",
    "mobile:sync": "node scripts/sync-mobile.js",
    "mobile:add": "npx cap add android",
    "mobile:sync:android": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "pc:start": "electron .",
    "pc:dist": "electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "typescript": "^7.0.2",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "main": "electron-main.js",
  "build": {
    "appId": "com.appoficina.control",
    "productName": "AppOficina",
    "files": ["index.html", "app.js", "styles.css", "server.js", "electron-main.js", "preload.js", "network.config.json"],
    "win": { "target": ["portable"] }
  }
}
